        "type": "inject",
        "z": "flowMotor01",
        "name": "Inicializar al arrancar",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "0.5",
        "topic": "",
        "payload": "INIT",
        "payloadType": "str",
        "x": 160,
        "y": 330,
