    },
    {
        "id": "fnLogica",
        "type": "function",
        "z": "flowMotor01",
        "name": "Lógica del motor",
        "func": "// Lógica de control con enclavamiento y paro de emergencia\nlet estado = flow.get('estadoMotor') || 'PARADO';\nconst cmd = String(msg.payload).toUpperCase();\n\nswitch (cmd) {\n    case 'MARCHA':\n        if (estado === 'PARADO') estado = 'MARCHA';\n        break;\n    case 'PARADA':\n        if (estado === 'MARCHA') estado = 'PARADO';\n        break;\n    case 'EMERGENCIA':\n        estado = 'EMERGENCIA';\n        break;\n    case 'RESET':\n        if (estado === 'EMERGENCIA') estado = 'PARADO';\n        break;\n}\n\nflow.set('estadoMotor', estado);\nnode.status({\n    fill: estado === 'MARCHA' ? 'green' : (estado === 'EMERGENCIA' ? 'yellow' : 'red'),\n    shape: 'dot',\n    text: estado\n});\n\nconst msgEstado = { topic: 'estado', payload: estado };\nconst msgContactor = { topic: 'contactor', payload: estado === 'MARCHA' };\nreturn [msgEstado, msgContactor];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 200,
        "wires": [["tplImagen", "tplLeds"], ["dbgContactor"]]
    },
    {
        "id": "tplImagen",
        "type": "ui_template",
        "z": "flowMotor01",
        "group": "uiGrpImagen",
        "name": "Imagen del motor",
        "order": 1,
        "width": "6",
        "height": "5",
        "format": "<style>\n.mt-wrap{display:flex;flex-direction:column;align-items:center;}\n.mt-rotor{transform-box:view-box;transform-origin:236px 85px;}\n.mt-girando .mt-rotor{animation:mt-giro .6s linear infinite;}\n@keyframes mt-giro{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}\n.mt-body{transition:fill .4s;}\n.mt-estado{font-size:16px;font-weight:bold;margin-top:4px;letter-spacing:1px;}\n</style>\n<div class='mt-wrap' ng-class=\"{'mt-girando': msg.payload==='MARCHA'}\">\n  <svg viewBox='0 0 270 160' width='100%' style='max-height:200px'>\n    <rect x='30' y='142' width='200' height='10' rx='2' fill='#37474f'/>\n    <rect x='55' y='126' width='28' height='18' fill='#455a64'/>\n    <rect x='150' y='126' width='28' height='18' fill='#455a64'/>\n    <rect class='mt-body' x='40' y='40' width='150' height='90' rx='14' fill='#546e7a' ng-attr-fill=\"{{ msg.payload==='MARCHA' ? '#2e7d32' : (msg.payload==='EMERGENCIA' ? '#b71c1c' : '#546e7a') }}\"/>\n    <g stroke='rgba(0,0,0,0.25)' stroke-width='3'>\n      <line x1='52' y1='55' x2='178' y2='55'/>\n      <line x1='52' y1='67' x2='178' y2='67'/>\n      <line x1='52' y1='79' x2='178' y2='79'/>\n      <line x1='52' y1='103' x2='178' y2='103'/>\n      <line x1='52' y1='115' x2='178' y2='115'/>\n    </g>\n    <text x='115' y='97' text-anchor='middle' font-size='16' font-weight='bold' fill='#ffffff'>M 3~</text>\n    <rect x='95' y='22' width='42' height='20' rx='3' fill='#263238'/>\n    <rect x='190' y='50' width='14' height='70' rx='3' fill='#37474f'/>\n    <rect x='204' y='81' width='14' height='8' fill='#90a4ae'/>\n    <g class='mt-rotor'>\n      <circle cx='236' cy='85' r='20' fill='#cfd8dc' stroke='#455a64' stroke-width='3'/>\n      <rect x='233' y='67' width='6' height='36' fill='#455a64'/>\n      <rect x='218' y='82' width='36' height='6' fill='#455a64'/>\n      <circle cx='236' cy='85' r='4' fill='#263238'/>\n    </g>\n  </svg>\n  <div class='mt-estado'>{{ msg.payload || 'PARADO' }}</div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 680,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "tplLeds",
        "type": "ui_template",
        "z": "flowMotor01",
        "group": "uiGrpEstado",
        "name": "LEDs de estado",
        "order": 1,
        "width": "6",
        "height": "2",
        "format": "<style>\n.led-panel{display:flex;justify-content:space-around;padding:6px 0;}\n.led-item{display:flex;flex-direction:column;align-items:center;font-size:12px;font-weight:bold;}\n.led{width:32px;height:32px;border-radius:50%;margin-bottom:6px;border:2px solid #222;opacity:.2;box-shadow:inset 0 -4px 6px rgba(0,0,0,.4);transition:opacity .2s;}\n.led-verde{background:#00e676;}\n.led-rojo{background:#ff1744;}\n.led-ambar{background:#ffab00;}\n.led.on{opacity:1;}\n.led-verde.on{box-shadow:0 0 16px 4px #00e676;}\n.led-rojo.on{box-shadow:0 0 16px 4px #ff1744;}\n.led-ambar.on{box-shadow:0 0 16px 4px #ffab00;animation:led-blink .8s step-start infinite;}\n@keyframes led-blink{50%{opacity:.2;}}\n</style>\n<div class='led-panel'>\n  <div class='led-item'><div class='led led-verde' ng-class=\"{on: msg.payload==='MARCHA'}\"></div>MARCHA</div>\n  <div class='led-item'><div class='led led-rojo' ng-class=\"{on: !msg.payload || msg.payload==='PARADO'}\"></div>PARADO</div>\n  <div class='led-item'><div class='led led-ambar' ng-class=\"{on: msg.payload==='EMERGENCIA'}\"></div>FALLA</div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 670,
        "y": 220,
        "wires": [[]]
    },
    {
        "id": "dbgContactor",
        "type": "debug",
        "z": "flowMotor01",
        "name": "Salida contactor (reemplazar por GPIO/Modbus/MQTT)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 760,
        "y": 290,
        "wires": []
    }
]
